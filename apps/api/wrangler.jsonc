{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowledge-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knowledge-app",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
